import java.util.Scanner;
public class Main{
    public static void main(String[]args){
        Scanner sc =new Scanner(System.in);
        int n=sc.nextInt();
        int small=9;
        while(n!=0)
        {
            int digit=n%10;
            
            n=n/10;
            if(small>=digit){
                small=digit;
            }
            
        }System.out.println(small);
        
        
}
}
