import java.util.Scanner;
public class Main{
    public static void main(String[]args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int rev=0;
        int find=0;
        while(n!=0){
            int digit=n%10;
            
            if(digit>=find)
            {
                find=digit;
            }
            n=n/10;
          
        }
        System.out.println(find);
    }
}
