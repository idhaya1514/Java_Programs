import java.util.Scanner;
class Main{
    public static void main(String []args)
    {
        Scanner sc = new Scanner(System.in);
        int n=sc.nextInt();
        int[]arr=new int[n];
        
        int max=arr[0];
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        
        for(int i=0;i<n;i++){
            int sum=0;
        for(int j=i;j<n;j++){
            sum=sum+arr[j];
            if(sum>max){
                max=sum;
            }
            
        }
    }
    System.out.println(max);
}
}
