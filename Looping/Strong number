import java.util.Scanner;
public class Main{
    public static void main(String[]args){
        Scanner sc =new Scanner(System.in);
        int n=sc.nextInt();
        int sum=0;
        int org=n;
        while(n!=0){
            int digit=n%10;
            int fact=1;
            for(int i=digit;i>0;i--){
            fact*=i;
          
            
        }
        n=n/10;
        sum=sum+fact;
        }
        if(org==sum){
            System.out.println("Strong Number");
        }
        else{
            System.out.println("Not A Strong Number");
        }  
        
}
}
