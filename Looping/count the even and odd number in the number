import java.util.Scanner;
public class Main{
    public static void main(String[]args){
        Scanner sc =new Scanner(System.in);
        int n=sc.nextInt();
        int c_even=0;
        int c_odd=0;
        while(n!=0){
            int digit=n%10;
            if(digit%2==0){
                c_even++;
            }
            else{
                c_odd++;
            }
            n=n/10;
        }
        System.out.println("Count of the even digits are"+ c_even);
        System.out.println("Count of the odd digits are"+ c_odd);
        
}
}
